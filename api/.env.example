# Copy to .env and fill in. Never commit .env — it holds real credentials.

# Local dev: use the Postgres from docker-compose.yml at the repo root.
# Production: a Neon pooled connection string (the one with "-pooler" in the host).
DATABASE_URL="postgresql://applied:applied@localhost:5432/applied?schema=public"

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
# Gmail API must be enabled, and your own address added under OAuth consent
# screen -> Test users, or Google will refuse the login.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/google/callback"

# 6380, not 6379 — docker-compose maps it there to avoid clashing with other
# local Redis instances. Change both together if you remap it.
REDIS_URL="redis://localhost:6380"

# 3001, not 3000 — the Next.js dev server owns 3000.
PORT=3001
