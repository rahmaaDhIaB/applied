generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here — the connection string lives in
// prisma.config.ts, so there's a single source of config.
datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  googleId     String @unique
  accessToken  String?
  refreshToken String?

  // Gmail incremental sync cursor. Storing this is what makes the second sync
  // cheap: we ask Gmail "what changed since X" instead of refetching everything.
  lastHistoryId String?
  lastSyncedAt  DateTime?

  createdAt    DateTime       @default(now())
  applications Application[]
  messages     EmailMessage[]
}

enum ApplicationStatus {
  APPLIED
  ACKNOWLEDGED // auto-reply received, no human yet
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  GHOSTED // no reply for N days — derived by us, never received
}

model Application {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  company String
  // Normalized key for fuzzy-matching incoming mail back to an application:
  // "Acme Inc." / "careers@acme.com" / "ACME" all reduce to "acme".
  companyKey String
  role       String?

  status      ApplicationStatus @default(APPLIED)
  appliedAt   DateTime
  lastEventAt DateTime

  messages EmailMessage[]
  events   StatusEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, companyKey])
}

model EmailMessage {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  // Gmail's own message id. This unique constraint is the idempotency key:
  // re-running a sync can never create duplicates.
  gmailId    String   @unique
  threadId   String
  fromEmail  String
  fromName   String?
  subject    String
  snippet    String   @db.Text
  receivedAt DateTime

  // What the classifier decided and how sure it was. Keeping the score lets you
  // review low-confidence calls instead of trusting them blindly.
  classification String?
  confidence     Float?

  createdAt DateTime @default(now())

  @@index([userId, receivedAt])
  @@index([applicationId])
}

model StatusEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  from      ApplicationStatus?
  to        ApplicationStatus
  reason    String
  createdAt DateTime           @default(now())

  @@index([applicationId, createdAt])
}
